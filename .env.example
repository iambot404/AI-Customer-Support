# Flask Secret Key for session signing
SECRET_KEY=your_secret_key_here

# Google Gemini API credentials
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database configuration (defaults to SQLite if DATABASE_URL is empty)
# Local SQLite default: support_tickets.db
DATABASE_URL=
# For Supabase / Postgres:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.mcgbcmaybudlfowynvgi.supabase.co:5432/postgres

# Optional Supabase REST credentials
SUPABASE_URL=https://mcgbcmaybudlfowynvgi.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
